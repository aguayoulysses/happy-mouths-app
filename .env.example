# --- Database (Turso in prod; a local file works for dev) ---
DATABASE_URL=file:./data/happy-mouths.db
DATABASE_AUTH_TOKEN=

# --- App ---
BASE_URL=http://localhost:3016
ADMIN_PASSWORD=
CRON_SECRET=

# --- Twilio (parent account API key; per-business overrides live in the DB) ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# House Messaging Service used when a business has no line of its own,
# and for texts to owners (weekly summary, feedback alerts).
TWILIO_HM_MESSAGING_SERVICE_SID=
SMS_DRY_RUN=true

# --- Google Business Profile (agency refresh token, same as client-pulse) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# --- Apple push (same .p8 as LM Growth works; bundle id differs) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=com.yourbrand.app
APNS_SANDBOX=

# --- Claude (review reply drafts) ---
ANTHROPIC_API_KEY=

# --- Poster images (optional external image API). Unset = plain text messages.
POSTER_API_URL=
POSTER_API_KEY=

# --- Meta Lead Ads (your own ad campaign → text the sales phone) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
HM_LEAD_ALERT_PHONES=+15555550100
HM_LEAD_ALERT_FROM=
